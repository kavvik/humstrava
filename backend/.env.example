# Supabase PostgreSQL connection string
# Найти в Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Секретный ключ для ESP32 → backend аутентификации
API_KEY=change-me-to-random-32-chars

# Telegram (опционально — без них уведомления просто молча отключаются)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL фронта — добавляется в текст Telegram-уведомления
FRONTEND_URL=https://humstrava.vercel.app

# Порог сессии в миллисекундах (3 минуты по умолчанию).
# См. docs/open-questions.md → OQ-018
SESSION_GAP_MS=180000
